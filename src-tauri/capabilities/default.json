{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for every Many Write window (the first one and those opened with File › New window).",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "core:webview:allow-create-webview-window",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
